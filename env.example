# Port ที่ต้องการให้ Server รัน (ปกติใช้ 3000)
PORT=3000

# คีย์ API จาก Google Cloud (YouTube Data API v3)
# ถ้ามีหลายคีย์ ให้คั่นด้วยเครื่องหมายจุลภาค (,) โดยห้ามเว้นวรรค
# วิธีนี้ช่วยป้องกันโควต้าเต็ม (Quota Exceeded) ระบบจะสลับคีย์ให้อัตโนมัติ
YOUTUBE_API_KEY=YOUR_API_KEY_1,YOUR_API_KEY_2,YOUR_API_KEY_3

# ชื่อโดเมนจริงของคุณ (ใช้สำหรับหลอก Google ว่าคำขอมาจากเว็บนี้)
# สำคัญ: ต้องตรงกับที่ตั้งค่าไว้ใน Google Cloud Console > API Key > Website restrictions
DOMAIN=https://oke.e29ckg.org